+/* Link cable between two emulators in one process, at byte granularity: when one
+ * side starts an internal-clock transfer and the other is waiting on an external
+ * clock, they swap bytes. Otherwise the master reads $FF, as with no cable. */
+static Emulator* s_link[2];
+
+void emulator_link(Emulator* a, Emulator* b) {
+  s_link[0] = a;
+  s_link[1] = b;
+}
+
+static u8 serial_link_exchange(Emulator* e, u8 out) {
+  Emulator* peer = e == s_link[0] ? s_link[1] : e == s_link[1] ? s_link[0] : NULL;
+  if (!peer) return 0xff;
+  Serial* ps = &peer->state.serial;
+  if (!ps->transferring || ps->clock != SERIAL_CLOCK_EXTERNAL) return 0xff;
+  u8 in = ps->sb;
+  ps->sb = out;
+  ps->transferring = 0;
+  peer->state.interrupt.new_if |= IF_SERIAL;
+  return in;
+}
+
 static void calculate_next_serial_intr(Emulator* e) {
   if (!SERIAL.transferring || SERIAL.clock != SERIAL_CLOCK_INTERNAL) {
     SERIAL.next_intr_ticks = INVALID_TICKS;
@@ -4070,6 +4097,7 @@ static void serial_synchronize(Emulator* e) {
           SERIAL.sb = (SERIAL.sb << 1) | 1;
           SERIAL.transferred_bits++;
           if (VALUE_WRAPPED(SERIAL.transferred_bits, 8)) {
+            SERIAL.sb = SERIAL.link_in;
             SERIAL.transferring = 0;
